ectSecrecy.encrypt_key_injective", "Cslib.Crypto.Protocols.PerfectSecrecy.shannonKeySpace"], "used_premises": ["Cslib.Crypto.Protocols.PerfectSecrecy.EncScheme", "Cslib.Crypto.Protocols.PerfectSecrecy.perfectlySecret_iff_indep", "Finset", "Finset.Nonempty", "Finset.mem_insert_self", "PMF.uniformOfFinset", "Eq.trans", "Eq.symm", "PMF.mem_support_uniformOfFinset_iff", "Iff.mpr", "ne_top_of_le_ne_top", "ENNReal.one_ne_top", "PMF.coe_le_one", "ENNReal.mul_right_inj", "Iff.mp", "Cslib.Crypto.Protocols.PerfectSecrecy.jointDist_eq"], "used_local_premises": [], "depends_on_local_physlib": false, "line_start": 87, "line_end": 101, "tags": ["leandojo_v2", "real_trace"], "trace_backend": "leandojo_v2", "proof_extraction_method": "lean_dojo_tactic_proof", "filter_excluded_reason": null, "quality_flags": [], "quality_metrics": {}, "source_url": "https://github.com/leanprover-community/physlib.git", "source_commit": "6d112db496f8528f4991fd7be32257e89861a4d7"}
