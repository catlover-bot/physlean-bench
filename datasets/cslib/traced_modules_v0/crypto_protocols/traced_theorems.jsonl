.shannonKeySpace"], "used_premises": ["Finite", "Cslib.Crypto.Protocols.PerfectSecrecy.EncScheme", "Nat.card", "Cslib.Crypto.Protocols.PerfectSecrecy.ciphertextIndist_of_perfectlySecret", "IsEmpty", "PMF.support_nonempty", "PMF.support", "PMF.mem_support_bind_iff", "Iff.mp", "Nat.card_le_card_of_injective", "Cslib.Crypto.Protocols.PerfectSecrecy.encrypt_key_injective"], "used_local_premises": [], "depends_on_local_physlib": false, "line_start": 115, "line_end": 129, "tags": ["leandojo_v2", "real_trace"], "trace_backend": "leandojo_v2", "proof_extraction_method": "lean_dojo_tactic_proof", "filter_excluded_reason": null, "quality_flags": [], "quality_metrics": {}, "source_url": "https://github.com/leanprover-community/physlib.git", "source_commit": "6d112db496f8528f4991fd7be32257e89861a4d7"}
