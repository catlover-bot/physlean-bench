{"theorem_id": "_project_nlp-work11_hirotaka-m_cslib_cache_parts_languages_combinatorylogic_confluence_gitpython-cslib-6d112db496f8528f4991fd7be32257e89861a4d7_cslib@6d112db496f8528f4991fd7be32257e89861a4d7:Cslib_Languages_CombinatoryLogic_Confluence.lean:Cslib.SKI.parallelReduction_diamond", "declaration_name": "Cslib.SKI.parallelReduction_diamond", "namespace": "Cslib.SKI", "module_path": "Cslib.Languages.CombinatoryLogic.Confluence", "file_path": "Cslib/Languages/CombinatoryLogic/Confluence.lean", "statement": "theorem parallelReduction_diamond : Diamond ParallelReduction :=", "proof_text": "by\n  intro a a₁ a₂ h₁ h₂\n  cases h₁\n  case refl => exact ⟨a₂, h₂, .refl a₂⟩\n  case par a a' b b' ha' hb' =>\n    cases h₂\n    case refl =>\n      use a' ⬝ b'\n      exact ⟨.refl (a' ⬝ b'), .par ha' hb'⟩\n    case par a'' b'' ha'' hb'' =>\n      let ⟨a₃, ha⟩ := parallelReduction_diamond ha' ha''\n      let ⟨b₃, hb⟩ := parallelReduction_diamond hb' hb''\n      use a₃ ⬝ b₃\n      constructor\n      · exact .par ha.1 hb.1\n      · exact .par ha.2 hb.2\n    case red_I =>\n      rw [I_irreducible a' ha']\n      use b', .red_I b'\n    case red_K =>\n      let ⟨a₂', ha₂'⟩ := Ka_irreducible a₂ a' ha'\n      rw [ha₂'.2]\n      use a₂'\n      exact ⟨.red_K a₂' b', ha₂'.1⟩\n    case red_S a c =>\n      let ⟨a'', c', h⟩ := Sab_irreducible a c a' ha'\n      rw [h.2.2]\n      use a'' ⬝ b' ⬝ (c' ⬝ b'), .red_S a'' c' b'\n      apply ParallelReduction.par <;>\n        apply ParallelReduction.par <;>\n        grind\n  case red_I =>\n    cases h₂\n    case refl => use a₁; exact ⟨.refl a₁, .red_I a₁⟩\n    case par c a₁' hc ha =>\n      rw [I_irreducible c hc]\n      use a₁'\n      exact ⟨ha, .red_I a₁'⟩\n    case red_I => use a₁; exact ⟨.refl a₁, .refl a₁⟩\n  case red_K c =>\n    cases h₂\n    case refl => use a₁; exact ⟨.refl a₁, .red_K a₁ c⟩\n    case par a' c' ha hc =>\n      let ⟨a₁', h'⟩ := Ka_irreducible a₁ a' ha\n      rw [h'.2]\n      use a₁'\n      exact ⟨h'.1, .red_K a₁' c'⟩\n    case red_K =>\n      use a₁; exact ⟨.refl a₁, .refl a₁⟩\n  case red_S a b c =>\n    cases h₂\n    case refl =>\n      use a ⬝ c ⬝ (b ⬝ c)\n      exact ⟨.refl _, .red_S ..⟩\n    case par d c' hd hc =>\n      let ⟨a', b', h⟩ := Sab_irreducible a b d hd\n      rw [h.2.2]\n      use a' ⬝ c' ⬝ (b' ⬝ c')\n      constructor\n      · apply ParallelReduction.par\n        · exact .par h.left hc\n        · exact .par h.2.1 hc\n      · exact .red_S ..\n    case red_S => exact ⟨a ⬝ c ⬝ (b ⬝ c), .refl _, .refl _,⟩", "imports": [], "declaration_kind": "commandtheorem", "has_sorry": false, "has_admit": false, "is_auto_generated": false, "accessible_premises": ["Cslib.SKI.ParallelReduction", "Cslib.SKI.mRed_of_parallelReduction", "Cslib.SKI.parallelReduction_of_red", "Cslib.SKI.reflTransGen_parallelReduction_mRed", "Cslib.SKI.I_irreducible", "Cslib.SKI.K_irreducible", "Cslib.SKI.Ka_irreducible", "Cslib.SKI.S_irreducible", "Cslib.SKI.Sa_irreducible", "Cslib.SKI.Sab_irreducible", "Cslib.SKI.parallelReduction_diamond", "Cslib.SKI.join_parallelReduction_equivalence", "Cslib.SKI.mJoin_red_equivalence", "Cslib.SKI.MRed.diamond"], "used_premises": ["Relation.Diamond", "Cslib.SKI.ParallelReduction", "Cslib.SKI.I_irreducible", "Cslib.SKI.Ka_irreducible", "Cslib.SKI.Sab_irreducible", "Cslib.SKI.ParallelReduction.par"], "used_local_premises": [], "depends_on_local_physlib": false, "line_start": 142, "line_end": 205, "tags": ["leandojo_v2", "real_trace"], "trace_backend": "leandojo_v2", "proof_extraction_method": "lean_dojo_tactic_proof", "filter_excluded_reason": null, "quality_flags": [], "quality_metrics": {}, "source_url": "https://github.com/leanprover-community/physlib.git", "source_commit": "6d112db496f8528f4991fd7be32257e89861a4d7"}
