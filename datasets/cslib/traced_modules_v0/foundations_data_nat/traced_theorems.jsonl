egment'_eq_segment", "Nat.segment_zero'", "Nat.segment_upper_bound'", "Nat.segment_lower_bound'"], "used_premises": ["StrictMono", "Nat.segment", "Nat.segment_idem", "Nat.strictMono_range_gap", "Nat.count", "Set.range", "Nat.nth_of_strictMono", "Nat.count_succ", "Set.mem_range", "Nat.count_nth_of_infinite", "Nat.strictMono_infinite"], "used_local_premises": [], "depends_on_local_physlib": false, "line_start": 153, "line_end": 174, "tags": ["leandojo_v2", "real_trace"], "trace_backend": "leandojo_v2", "proof_extraction_method": "lean_dojo_tactic_proof", "filter_excluded_reason": null, "quality_flags": [], "quality_metrics": {}, "source_url": "https://github.com/leanprover-community/physlib.git", "source_commit": "6d112db496f8528f4991fd7be32257e89861a4d7"}
