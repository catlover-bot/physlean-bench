{"theorem_id": "_project_nlp-work11_hirotaka-m_cslib_cache_parts_foundations_combinatorics_infinitegraphramsey_gitpython-cslib-6d112db496f8528f4991fd7be32257e89861a4d7_cslib@6d112db496f8528f4991fd7be32257e89861a4d7:Cslib_Foundations_Combinatorics_InfiniteGraphRamsey.lean:Cslib.infinite_pigeonhole_principle", "declaration_name": "Cslib.infinite_pigeonhole_principle", "namespace": "Cslib", "module_path": "Cslib.Foundations.Combinatorics.InfiniteGraphRamsey", "file_path": "Cslib/Foundations/Combinatorics/InfiniteGraphRamsey.lean", "statement": "theorem infinite_pigeonhole_principle {X Y : Type*} [Finite Y] (f : X → Y) {s : Set X}\n    (h_inf : s.Infinite) : ∃ y, ∃ t, t.Infinite ∧ t ⊆ s ∧ ∀ x ∈ t, f x = y :=", "proof_text": "by\n  have := h_inf.to_subtype\n  obtain ⟨y, h_inf'⟩ := Finite.exists_infinite_fiber (s.restrict f)\n  have h_inf_iff := Equiv.infinite_iff <|\n    Equiv.subtypeSubtypeEquivSubtypeInter (· ∈ s) (fun x ↦ f x = y)\n  simp only [coe_eq_subtype, mem_preimage, restrict_apply, mem_singleton_iff, h_inf_iff] at h_inf'\n  have h_inf'' := (infinite_coe_iff (s := { x | x ∈ s ∧ f x = y })).mp h_inf'\n  use y, {x | x ∈ s ∧ f x = y}\n  grind", "imports": [], "declaration_kind": "commandtheorem", "has_sorry": false, "has_admit": false, "is_auto_generated": false, "accessible_premises": ["Cslib.infinite_pigeonhole_principle", "Cslib.InfVSet", "Cslib.Selection", "Cslib.GoodSelection", "Cslib.goodSelection_exists", "Cslib.goodSelection_seq", "Cslib.goodSelection_seq_prop", "Cslib.good_selections_exist", "Cslib.infinite_graph_ramsey"], "used_premises": ["Finite", "Set", "Finite.exists_infinite_fiber", "Equiv.infinite_iff", "Equiv.subtypeSubtypeEquivSubtypeInter", "Set.coe_eq_subtype", "Set.mem_preimage", "Set.restrict_apply", "Set.mem_singleton_iff", "Set.infinite_coe_iff", "Iff.mp"], "used_local_premises": [], "depends_on_local_physlib": false, "line_start": 29, "line_end": 38, "tags": ["leandojo_v2", "real_trace"], "trace_backend": "leandojo_v2", "proof_extraction_method": "lean_dojo_tactic_proof", "filter_excluded_reason": null, "quality_flags": [], "quality_metrics": {}, "source_url": "https://github.com/leanprover-community/physlib.git", "source_commit": "6d112db496f8528f4991fd7be32257e89861a4d7"}
{"theorem_id": "_project_nlp-work11_hirotaka-m_cslib_cache_parts_foundations_combinatorics_infinitegraphramsey_gitpython-cslib-6d112db496f8528f4991fd7be32257e89861a4d7_cslib@6d112db496f8528f4991fd7be32257e89861a4d7:Cslib_Foundations_Combinatorics_InfiniteGraphRamsey.lean:Cslib.goodSelection_exists", "declaration_name": "Cslib.goodSelection_exists", "namespace": "Cslib", "module_path": "Cslib.Foundations.Combinatorics.InfiniteGraphRamsey", "file_path": "Cslib/Foundations/Combinatorics/InfiniteGraphRamsey.lean", "statement": "private lemma goodSelection_exists (ivs : InfVSet Vertex) :\n    ∃ S : Selection Vertex Color, GoodSelection color ivs S :=", "proof_text": "by\n  classical\n  obtain ⟨v, h_v⟩ := Set.Infinite.nonempty ivs.inf\n  let f u := color {v, u}\n  obtain ⟨c, vs, h_inf, h_vs, h_col⟩ := infinite_pigeonhole_principle f <|\n    Set.Infinite.diff ivs.inf (finite_singleton v)\n  simp only [subset_diff] at h_vs\n  let ivs' := InfVSet.mk vs h_inf\n  use {vs := ivs', v := v, c := c}\n  grind [GoodSelection]", "imports": [], "declaration_kind": "lemma", "has_sorry": false, "has_admit": false, "is_auto_generated": false, "accessible_premises": ["Cslib.infinite_pigeonhole_principle", "Cslib.InfVSet", "Cslib.Selection", "Cslib.GoodSelection", "Cslib.goodSelection_exists", "Cslib.goodSelection_seq", "Cslib.goodSelection_seq_prop", "Cslib.good_selections_exist", "Cslib.infinite_graph_ramsey"], "used_premises": ["_private.Cslib.Foundations.Combinatorics.InfiniteGraphRamsey.0.Cslib.InfVSet", "_private.Cslib.Foundations.Combinatorics.InfiniteGraphRamsey.0.Cslib.Selection", "_private.Cslib.Foundations.Combinatorics.InfiniteGraphRamsey.0.Cslib.GoodSelection", "Set.Infinite.nonempty", "Cslib.infinite_pigeonhole_principle", "Set.Infinite.diff", "Set.finite_singleton", "Set.subset_diff", "_private.Cslib.Foundations.Combinatorics.InfiniteGraphRamsey.0.Cslib.InfVSet.mk"], "used_local_premises": [], "depends_on_local_physlib": false, "line_start": 65, "line_end": 76, "tags": ["leandojo_v2", "real_trace"], "trace_backend": "leandojo_v2", "proof_extraction_method": "lean_dojo_tactic_proof", "filter_excluded_reason": null, "quality_flags": [], "quality_metrics": {}, "source_url": "https://github.com/leanprover-community/physlib.git", "source_commit": "6d112db496f8528f4991fd7be32257e89861a4d7"}
{"theorem_id": "_project_nlp-work11_hirotaka-m_cslib_cache_parts_foundations_combinatorics_infinitegraphramsey_gitpython-cslib-6d112db496f8528f4991fd7be32257e89861a4d7_cslib@6d112db496f8528f4991fd7be32257e89861a4d7:Cslib_Foundations_Combinatorics_InfiniteGraphRamsey.lean:Cslib.goodSelection_seq_prop", "declaration_name": "Cslib.goodSelection_seq_prop", "namespace": "Cslib", "module_path": "Cslib.Foundations.Combinatorics.InfiniteGraphRamsey", "file_path": "Cslib/Foundations/Combinatorics/InfiniteGraphRamsey.lean", "statement": "private lemma goodSelection_seq_prop (n : ℕ) :\n    ∃ ivs : InfVSet Vertex, GoodSelection color ivs (goodSelection_seq color n) ∧\n      (ivs.set = ⋂ m < n, (goodSelection_seq color m).vs.set) :=", "proof_text": "by\n  induction n\n  case zero =>\n    use (InfVSet.mk univ infinite_univ)\n    simp\n    grind [goodSelection_seq]\n  case succ n h_ind =>\n    obtain ⟨_, _, h_eq⟩ := h_ind\n    use (goodSelection_seq color n).vs\n    constructor\n    · grind [goodSelection_seq]\n    · have h1 (m : ℕ) : m < n + 1 ↔ m < n ∨ m = n := by grind\n      simp [h1, iInter_or, iInter_inter_distrib, ← h_eq]\n      grind [GoodSelection]", "imports": [], "declaration_kind": "lemma", "has_sorry": false, "has_admit": false, "is_auto_generated": false, "accessible_premises": ["Cslib.infinite_pigeonhole_principle", "Cslib.InfVSet", "Cslib.Selection", "Cslib.GoodSelection", "Cslib.goodSelection_exists", "Cslib.goodSelection_seq", "Cslib.goodSelection_seq_prop", "Cslib.good_selections_exist", "Cslib.infinite_graph_ramsey"], "used_premises": ["_private.Cslib.Foundations.Combinatorics.InfiniteGraphRamsey.0.Cslib.InfVSet", "_private.Cslib.Foundations.Combinatorics.InfiniteGraphRamsey.0.Cslib.GoodSelection", "_private.Cslib.Foundations.Combinatorics.InfiniteGraphRamsey.0.Cslib.goodSelection_seq", "_private.Cslib.Foundations.Combinatorics.InfiniteGraphRamsey.0.Cslib.InfVSet.mk", "Set.univ", "Set.infinite_univ", "_private.Cslib.Foundations.Combinatorics.InfiniteGraphRamsey.0.Cslib.Selection.vs", "Set.iInter_or", "Set.iInter_inter_distrib"], "used_local_premises": [], "depends_on_local_physlib": false, "line_start": 86, "line_end": 103, "tags": ["leandojo_v2", "real_trace"], "trace_backend": "leandojo_v2", "proof_extraction_method": "lean_dojo_tactic_proof", "filter_excluded_reason": null, "quality_flags": [], "quality_metrics": {}, "source_url": "https://github.com/leanprover-community/physlib.git", "source_commit": "6d112db496f8528f4991fd7be32257e89861a4d7"}
{"theorem_id": "_project_nlp-work11_hirotaka-m_cslib_cache_parts_foundations_combinatorics_infinitegraphramsey_gitpython-cslib-6d112db496f8528f4991fd7be32257e89861a4d7_cslib@6d112db496f8528f4991fd7be32257e89861a4d7:Cslib_Foundations_Combinatorics_InfiniteGraphRamsey.lean:Cslib.good_selections_exist", "declaration_name": "Cslib.good_selections_exist", "namespace": "Cslib", "module_path": "Cslib.Foundations.Combinatorics.InfiniteGraphRamsey", "file_path": "Cslib/Foundations/Combinatorics/InfiniteGraphRamsey.lean", "statement": "private lemma good_selections_exist :\n    ∃ vs : ℕ → Set Vertex, ∃ v : ℕ → Vertex, ∃ c : ℕ → Color,\n    ∀ n, vs n ⊆ (⋂ m < n, vs m) ∧ v n ∈ (⋂ m < n, vs m) \\ (vs n) ∧\n      ∀ u ∈ vs n, color {v n, u} = c n :=", "proof_text": "by\n  use (fun k ↦ (goodSelection_seq color k).vs.set)\n  use (fun k ↦ (goodSelection_seq color k).v)\n  use (fun k ↦ (goodSelection_seq color k).c)\n  intro n\n  obtain ⟨ivs, h_ivs, h_eq⟩ := goodSelection_seq_prop color n\n  rw [← h_eq]\n  exact h_ivs", "imports": [], "declaration_kind": "lemma", "has_sorry": false, "has_admit": false, "is_auto_generated": false, "accessible_premises": ["Cslib.infinite_pigeonhole_principle", "Cslib.InfVSet", "Cslib.Selection", "Cslib.GoodSelection", "Cslib.goodSelection_exists", "Cslib.goodSelection_seq", "Cslib.goodSelection_seq_prop", "Cslib.good_selections_exist", "Cslib.infinite_graph_ramsey"], "used_premises": ["Set", "_private.Cslib.Foundations.Combinatorics.InfiniteGraphRamsey.0.Cslib.goodSelection_seq", "_private.Cslib.Foundations.Combinatorics.InfiniteGraphRamsey.0.Cslib.Selection.v", "_private.Cslib.Foundations.Combinatorics.InfiniteGraphRamsey.0.Cslib.Selection.c", "_private.Cslib.Foundations.Combinatorics.InfiniteGraphRamsey.0.Cslib.goodSelection_seq_prop"], "used_local_premises": [], "depends_on_local_physlib": false, "line_start": 106, "line_end": 120, "tags": ["leandojo_v2", "real_trace"], "trace_backend": "leandojo_v2", "proof_extraction_method": "lean_dojo_tactic_proof", "filter_excluded_reason": null, "quality_flags": [], "quality_metrics": {}, "source_url": "https://github.com/leanprover-community/physlib.git", "source_commit": "6d112db496f8528f4991fd7be32257e89861a4d7"}
{"theorem_id": "_project_nlp-work11_hirotaka-m_cslib_cache_parts_foundations_combinatorics_infinitegraphramsey_gitpython-cslib-6d112db496f8528f4991fd7be32257e89861a4d7_cslib@6d112db496f8528f4991fd7be32257e89861a4d7:Cslib_Foundations_Combinatorics_InfiniteGraphRamsey.lean:Cslib.infinite_graph_ramsey", "declaration_name": "Cslib.infinite_graph_ramsey", "namespace": "Cslib", "module_path": "Cslib.Foundations.Combinatorics.InfiniteGraphRamsey", "file_path": "Cslib/Foundations/Combinatorics/InfiniteGraphRamsey.lean", "statement": "theorem infinite_graph_ramsey :\n    ∃ c : Color, ∃ s : Set Vertex, s.Infinite ∧\n      ∀ e : Finset Vertex, e.card = 2 → ↑e ⊆ s → color e = c :=", "proof_text": "by\n  classical\n  obtain ⟨vs, v, c, h_sel⟩ := good_selections_exist color\n  simp only [forall_and] at h_sel\n  obtain ⟨h_vs, h_v, h_c⟩ := h_sel\n  have : ∀ m n, m < n → v n ∈ vs m := by\n    intro m n h_mn\n    suffices h1 : (⋂ m < n, vs m) ⊆ vs m by grind\n    exact biInter_subset_of_mem h_mn\n  obtain ⟨c', s', h_s'_inf, h_s'_col⟩ :\n      ∃ c' : Color, ∃ s' : Set ℕ, s'.Infinite ∧ ∀ n ∈ s', c n = c' := by\n    obtain ⟨c', s', h_s'_inf, _, h_s'col⟩ := infinite_pigeonhole_principle c infinite_univ\n    use c', s'\n  use c', (v '' s')\n  have h_v_inj : Injective v := by\n    intro _ _\n    grind\n  split_ands\n  · exact Infinite.image (injOn_of_injective h_v_inj (s := s')) h_s'_inf\n  · simp only [Finset.card_eq_two]\n    grind [Finset.pair_comm, Finset.coe_insert, Finset.coe_singleton]", "imports": [], "declaration_kind": "commandtheorem", "has_sorry": false, "has_admit": false, "is_auto_generated": false, "accessible_premises": ["Cslib.infinite_pigeonhole_principle", "Cslib.InfVSet", "Cslib.Selection", "Cslib.GoodSelection", "Cslib.goodSelection_exists", "Cslib.goodSelection_seq", "Cslib.goodSelection_seq_prop", "Cslib.good_selections_exist", "Cslib.infinite_graph_ramsey"], "used_premises": ["Set", "Finset", "_private.Cslib.Foundations.Combinatorics.InfiniteGraphRamsey.0.Cslib.good_selections_exist", "forall_and", "Set.biInter_subset_of_mem", "Cslib.infinite_pigeonhole_principle", "Set.infinite_univ", "Function.Injective", "Set.Infinite.image", "Set.injOn_of_injective", "Finset.card_eq_two", "Finset.pair_comm", "Finset.coe_insert", "Finset.coe_singleton"], "used_local_premises": [], "depends_on_local_physlib": false, "line_start": 125, "line_end": 147, "tags": ["leandojo_v2", "real_trace"], "trace_backend": "leandojo_v2", "proof_extraction_method": "lean_dojo_tactic_proof", "filter_excluded_reason": null, "quality_flags": [], "quality_metrics": {}, "source_url": "https://github.com/leanprover-community/physlib.git", "source_commit": "6d112db496f8528f4991fd7be32257e89861a4d7"}
